    "    \"\"\"Cross-convolve observed and predicted data for source-independent FWI.\"\"\"\n",
    "    if d_obs.shape != d_pred.shape:\n",
    "        raise ValueError(\"Observed and predicted data must have the same shape\")\n",
    "    if d_obs.ndim != 3:\n",
    "        raise ValueError(\"Expected tensors of shape (n_shots, n_time, n_receivers)\")\n\n",
    "    n_shots, n_time, _ = d_obs.shape\n",
    "    if n_shots < 2:\n",
    "        # Cross-convolution requires at least two shots. Return original gathers.\n",
    "        return d_obs.permute(1, 0, 2), d_pred.permute(1, 0, 2)\n\n",
    "    # Ensure we have a deterministic shot ordering based on the source locations.\n",
    "    if x_s is not None:\n",
    "        if x_s.ndim < 2:\n",
    "            raise ValueError(\"Source locations must include shot information\")\n",
    "        # Use the horizontal coordinate of the first source for each shot as an index.\n",
    "        shot_indices = x_s[:, 0, 0]\n",
    "        order = torch.argsort(shot_indices)\n",
    "        inv_order = torch.empty_like(order)\n",
    "        inv_order[order] = torch.arange(n_shots, device=order.device)\n",
    "    else:\n",
    "        order = torch.arange(n_shots, device=d_obs.device)\n",
    "        inv_order = order\n\n",
    "    d_obs_sorted = d_obs.index_select(0, order)\n",
    "    d_pred_sorted = d_pred.index_select(0, order)\n\n",
    "    # Work in the frequency domain to perform (circular) convolutions efficiently.\n",
    "    d_obs_fft = torch.fft.rfft(d_obs_sorted, dim=1)\n",
    "    d_pred_fft = torch.fft.rfft(d_pred_sorted, dim=1)\n\n",
    "    d_obs_conv_fft = torch.zeros_like(d_obs_fft)\n",
    "    d_pred_conv_fft = torch.zeros_like(d_pred_fft)\n\n",
    "    for i in range(n_shots):\n",
    "        obs_i = d_obs_fft[i]\n",
    "        pred_i = d_pred_fft[i]\n\n",
    "        # Sum the cross-convolutions with all other shots (j != i).\n",
    "        obs_cross_fft = (obs_i.unsqueeze(0) * d_pred_fft).sum(dim=0) - obs_i * pred_i\n",
    "        pred_cross_fft = (pred_i.unsqueeze(0) * d_obs_fft).sum(dim=0) - pred_i * obs_i\n\n",
    "        d_obs_conv_fft[i] = obs_cross_fft\n",
    "        d_pred_conv_fft[i] = pred_cross_fft\n\n",
    "    d_obs_conv_sorted = torch.fft.irfft(d_obs_conv_fft, n=n_time, dim=1).real\n",
    "    d_pred_conv_sorted = torch.fft.irfft(d_pred_conv_fft, n=n_time, dim=1).real\n\n",
    "    d_obs_conv = d_obs_conv_sorted.index_select(0, inv_order)\n",
    "    d_pred_conv = d_pred_conv_sorted.index_select(0, inv_order)\n\n",
    "    return d_obs_conv.permute(1, 0, 2), d_pred_conv.permute(1, 0, 2)\n"
}